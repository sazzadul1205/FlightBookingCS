@model FlightBookingCS.ViewModel.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Account/_AuthLayout.cshtml";
}

<form asp-action="Register" method="post" class="space-y-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-sm text-red-600 bg-red-50 rounded-lg p-3">
        </div>
    }
    <div>
        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="Email"
               type="email"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 outline-none"
               placeholder="Enter your email" />
        <span asp-validation-for="Email" class="text-sm text-red-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="Password"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 outline-none"
               placeholder="Create a password"
               type="password" />
        <span asp-validation-for="Password" class="text-sm text-red-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="ConfirmPassword"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-150 outline-none"
               placeholder="Confirm your password"
               type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600 mt-1 block"></span>
    </div>

    <button type="submit"
            class="w-full bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-semibold py-2.5 px-4 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
        Register
    </button>

    <div class="text-center">
        <p class="text-sm text-gray-600">
            Already have an account?
            <a asp-action="Login"
               class="text-blue-600 hover:text-blue-800 font-medium hover:underline transition duration-150">
                Login
            </a>
        </p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}