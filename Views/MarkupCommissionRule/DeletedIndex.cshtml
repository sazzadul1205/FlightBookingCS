@model List<FlightBookingCS.ViewModel.MarkupCommissionRule.MarkupCommissionRuleIndexViewModel>

@{
    ViewData["Title"] = "Deleted Markup & Commission Rules";
}

@await Html.PartialAsync("_Alerts")

<div class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="overflow-hidden bg-white shadow-sm rounded-xl">
        <div class="flex flex-col gap-4 px-6 py-4 border-b border-gray-200 sm:flex-row sm:items-center sm:justify-between">
            <h5 class="text-lg font-semibold text-gray-900">Deleted Markup & Commission Rules</h5>
            <a asp-action="Index" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white transition-colors duration-200 bg-gray-600 rounded-lg hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Active Rules
            </a>
        </div>

        <div class="px-6 py-4">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-yellow-700 bg-yellow-100 rounded-lg">
                    <svg class="inline-block w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    No deleted rules found.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">#</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Airline Code</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Markup Type</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Markup Value</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Commission Type</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Commission Value</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-center text-gray-500 uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in Model.Select((value, index) => new { value, index }))
                            {
                                <tr class="transition-colors duration-200 hover:bg-gray-50">
                                    <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">@(item.index + 1)</td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900 whitespace-nowrap">@item.value.AirlineCode</td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap">
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold text-blue-800 bg-blue-100 rounded-full">@item.value.MarkupType</span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">@item.value.MarkupValue</td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap">
                                        <span class="inline-flex px-2 py-1 text-xs font-semibold text-green-800 bg-green-100 rounded-full">@item.value.CommissionType</span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">@item.value.CommissionValue</td>
                                    <td class="px-4 py-3 text-sm text-center whitespace-nowrap">
                                        <div class="inline-flex items-center gap-2">
                                            <form asp-action="Restore" asp-route-id="@item.value.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-white transition-colors duration-200 bg-green-600 rounded hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" onclick="return confirm('Are you sure you want to restore this rule?')">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                    </svg>
                                                    Restore
                                                </button>
                                            </form>
                                            <form asp-action="ForceDelete" asp-route-id="@item.value.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-white transition-colors duration-200 bg-red-600 rounded hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2" onclick="return confirm('Are you sure you want to permanently delete this rule? This action cannot be undone!')">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Force Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>