@{
    ViewData["Title"] = "Home Page";
    var isLoggedIn = ViewData["IsLoggedIn"] as bool? ?? false;
    var userName = ViewData["UserName"]?.ToString() ?? "Guest";
    var userEmail = ViewData["UserEmail"]?.ToString() ?? "";
    var jwtToken = ViewData["JwtToken"]?.ToString();
}

<div class="min-h-[60vh] flex items-center justify-center px-4 py-12">
    <div class="max-w-4xl w-full">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold text-gray-800 mb-4 tracking-tight">
                Welcome
            </h1>
            <p class="text-lg text-gray-600">Your flight booking companion</p>
        </div>

        @if (isLoggedIn)
        {
            <div
                class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-lg p-6 mb-8 shadow-sm">
                <div class="flex items-center gap-3">
                    <svg class="w-8 h-8 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                              clip-rule="evenodd" />
                    </svg>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800">You are logged in!</h3>
                        <p class="text-gray-600 mt-1">Welcome back, <span class="font-medium text-gray-800">@userName</span>
                        </p>
                        <p class="text-sm text-gray-500">@userEmail</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
                    <h5 class="text-white font-semibold text-lg flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        Your Session Information
                    </h5>
                </div>
                <div class="p-6">
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <p class="text-xs font-mono text-gray-600 break-all leading-relaxed">
                            @jwtToken
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-8 text-center">
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-block">
                    <button type="submit"
                            class="px-8 py-3 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
                        <span class="flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </span>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div
                class="bg-gradient-to-r from-yellow-50 to-orange-50 border-l-4 border-yellow-500 rounded-lg p-6 mb-8 shadow-sm">
                <div class="flex items-center gap-3">
                    <svg class="w-8 h-8 text-yellow-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                              d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                              clip-rule="evenodd" />
                    </svg>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-800">You are not logged in</h3>
                        <p class="text-gray-600 mt-1">Please login or register to access your account.</p>
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
                <a asp-controller="Account" asp-action="Login"
                   class="px-8 py-3 text-blue-700 bg-blue-100 hover:bg-blue-200 font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 text-center">
                    <span class="flex items-center justify-center gap-2">
                        Login
                    </span>
                </a>
                <a asp-controller="Account" asp-action="Register"
                   class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 text-center">
                    <span class="flex items-center justify-center gap-2">
                        Register
                    </span>
                </a>
            </div>
        }
    </div>
</div>