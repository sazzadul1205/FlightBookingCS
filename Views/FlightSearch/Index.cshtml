@model FlightBookingCS.ViewModel.CitiesViewModal

@{
    ViewData["Title"] = "Flight Search";
}

<div class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
    <div class="overflow-hidden bg-white shadow-sm rounded-xl">
        <!-- Header -->
        <div class="flex flex-col gap-4 px-6 py-4 border-b border-gray-200 sm:flex-row sm:items-center sm:justify-between">
            <h5 class="text-lg font-semibold text-gray-900">✈️ Flight Search</h5>
            <div class="text-sm text-gray-500">
                Search for airports and cities worldwide
            </div>
        </div>

        <!-- Search Box -->
        <div class="px-6 py-4 border-b border-gray-200">
            <div class="flex flex-col gap-3 sm:flex-row">
                <div class="flex-1">
                    <input type="text"
                           id="searchInput"
                           placeholder="Search for cities (e.g., 'SI', 'New York')"
                           autofocus
                           class="w-full px-4 py-2.5 border-2 border-gray-300 rounded-lg text-base focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all" />
                </div>
                <button id="searchButton"
                        onclick="searchCities()"
                        class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Search
                </button>
            </div>
        </div>

        <!-- Results Area -->
        <div class="px-6 py-4">
            <div id="results">
                <div class="p-4 text-center text-gray-500 bg-gray-50 rounded-lg">
                    <svg class="inline-block w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Enter a search term to find cities
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const searchButton = document.getElementById('searchButton');
    const resultsDiv = document.getElementById('results');

    // Search on Enter key
    searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            searchCities();
        }
    });

    async function searchCities() {
        const searchTerm = searchInput.value.trim();

        if (!searchTerm) {
            resultsDiv.innerHTML = `
                    <div class="p-4 text-sm text-red-700 bg-red-100 rounded-lg">
                        <svg class="inline-block w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Please enter a search term
                    </div>
                `;
            return;
        }

        // Show loading state
        searchButton.disabled = true;
        searchButton.innerHTML = `
                <svg class="w-4 h-4 mr-2 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Searching...
            `;

        resultsDiv.innerHTML = `
                <div class="p-4 text-center text-gray-500">
                    <svg class="inline-block w-5 h-5 mr-2 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Searching for cities...
                </div>
            `;

        try {
            const response = await fetch(`/FlightSearch/GetCities?search=${encodeURIComponent(searchTerm)}`);
            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || 'Failed to fetch cities');
            }

            displayResults(data);
        } catch (error) {
            resultsDiv.innerHTML = `
                    <div class="p-4 text-sm text-red-700 bg-red-100 rounded-lg">
                        <svg class="inline-block w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Error: ${error.message}
                    </div>
                `;
        } finally {
            searchButton.disabled = false;
            searchButton.innerHTML = `
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    Search
                `;
        }
    }

    function displayResults(data) {
        if (!data.success) {
            resultsDiv.innerHTML = `
                    <div class="p-4 text-sm text-red-700 bg-red-100 rounded-lg">
                        <svg class="inline-block w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        ${data.message || 'An error occurred'}
                    </div>
                `;
            return;
        }

        const cities = data.cities || [];

        if (cities.length === 0) {
            resultsDiv.innerHTML = `
                    <div class="p-4 text-center text-gray-500 bg-gray-50 rounded-lg">
                        <svg class="inline-block w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        No cities found for "<strong>${searchInput.value.trim()}</strong>"
                    </div>
                `;
            return;
        }

        // Build results table similar to your Markup & Commission page
        let html = `
                <div class="p-3 mb-4 text-sm text-green-700 bg-green-100 rounded-lg">
                    <svg class="inline-block w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    ${data.message || `Found ${cities.length} cities`}
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">#</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Airport Code</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Search String</th>
                                <th class="px-4 py-3 text-xs font-medium tracking-wider text-left text-gray-500 uppercase">Flag</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
            `;

        cities.forEach((city, index) => {
            const flagHtml = city.countryFlagUrl
                ? `<img src="${city.countryFlagUrl}" alt="Flag" class="w-8 h-5 object-cover rounded" />`
                : '<span class="text-xs text-gray-400">No flag</span>';

            html += `
                    <tr class="transition-colors duration-200 hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">${index + 1}</td>
                        <td class="px-4 py-3 text-sm font-medium text-blue-600 whitespace-nowrap">${city.airportCode}</td>
                        <td class="px-4 py-3 text-sm text-gray-700">${city.searchString}</td>
                        <td class="px-4 py-3 text-sm whitespace-nowrap">${flagHtml}</td>
                    </tr>
                `;
        });

        html += `
                        </tbody>
                    </table>
                </div>
            `;

        resultsDiv.innerHTML = html;
    }
</script>