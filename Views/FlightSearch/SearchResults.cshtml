                <span>✈️</span> ${count} flight${count > 1 ? 's' : ''} found
            </h2>
            <p class="text-sm text-gray-500 mt-1">${state.isFiltering ? '🎯 Filtered results' : 'All available flights'}</p>
        </div>
        <div class="text-right">
            <span class="text-xs text-gray-400">Best price</span>
            <p class="text-lg font-bold text-blue-600">$${Math.min(...flights.map(f => {
                const fare = f.fareBreakdown?.[0] || {};
                return f.newBaseFare > 0 ? f.newBaseFare + fare.totalTax : fare.totalFare || 0;
            })).toFixed(2)}</p>
        </div>
    </div>
    <div class="space-y-5">
`;

    flights.forEach((flight, idx) => {
        const firstSegment = flight.onwards?.[0] || {};
        const fare = flight.fareBreakdown?.[0] || {};
        const travelTime = flight.totalTravelTimes?.[0] || {};
        const segments = flight.onwards || [];

        // --- PRICING CALCULATIONS ---
        const baseFare = fare.baseFare || 0;
        const totalTax = fare.totalTax || 0;
        const totalFare = fare.totalFare || 0;
        const apiDiscount = fare.apiDiscount || 0;
        const fees = fare.fees || 0;
        const newBaseFare = flight.newBaseFare || 0;
        const newDiscount = flight.newDiscount || 0;
        const grossFare = newBaseFare > 0 ? newBaseFare + totalTax + newDiscount : totalFare;
        const netFare = newBaseFare > 0 ? newBaseFare + totalTax : totalFare;
        const hasPricing = newBaseFare > 0;

        // --- FLIGHT DATA ---
        const origin = firstSegment.origin || 'N/A';
        const dest = firstSegment.destination || 'N/A';
        const carrier = firstSegment.carrierName || 'N/A';
        const carrierCode = firstSegment.carrier || '';
        const flightNumber = firstSegment.flightNumber || '';
        const equipment = firstSegment.equipment || 'N/A';
        const operatingCarrier = firstSegment.operatingCarrierName || carrier;
        const isMultiSegment = segments.length > 1;
        const airlineColor = getAirlineColor(carrier);

        const isRefundable = flight.isRefundable || false;
        const isBookable = flight.isBookable || false;
        const passengerType = fare.passengerType || flight.passengerType || 'ADT';
        const noOfPassenger = fare.noOfPassenger || 1;
        const tripType = flight.tripType || 'OneWay';
        const fareType = flight.fareType || 'Published';
        const baggageAllowance = firstSegment.airBaggageAllowance || 'N/A';
        const bookingCode = firstSegment.bookingCode || 'N/A';
        const cabinClass = firstSegment.cabinClass || 'Economy';
        const fareBasis = firstSegment.fareBasis || 'N/A';

        const duration = travelTime.totalTravelDuration || 'N/A';
        const stops = travelTime.noOfStop || 0;
        const layoverTime = travelTime.totalLayoverTime || '0';
        const segmentCount = travelTime.segmentCount || 1;

        const depTime = formatTime(firstSegment.departureTime);
        const arrTime = formatTime(firstSegment.arrivalTime);
        const depDate = formatDate(firstSegment.departureTime);
        const arrDate = formatDate(firstSegment.arrivalTime);

        const brandedInfo = flight.brandedFareInfoes?.[0]?.brandedFareInfoDetail || {};
        const features = [];
        if (brandedInfo.cabinBaggage?.text) features.push({ icon: '🎒', label: 'Cabin', text: brandedInfo.cabinBaggage.text });
        if (brandedInfo.checkedBaggage?.text) features.push({ icon: '🧳', label: 'Checked', text: brandedInfo.checkedBaggage.text });
        if (brandedInfo.meal?.text) features.push({ icon: '🍽️', label: 'Meal', text: brandedInfo.meal.text });
        if (brandedInfo.seatSelection?.text) features.push({ icon: '💺', label: 'Seat', text: brandedInfo.seatSelection.text });
        if (brandedInfo.change?.text) features.push({ icon: '🔄', label: 'Change', text: brandedInfo.change.text });
        if (brandedInfo.cancellation?.text) features.push({ icon: '❌', label: 'Cancel', text: brandedInfo.cancellation.text });

        // --- PER‑PASSENGER PRICES (Net as main, Gross as strikethrough) ---
        const perPassengerNet = noOfPassenger > 0 ? (netFare / noOfPassenger).toFixed(2) : netFare.toFixed(2);
        const perPassengerGross = noOfPassenger > 0 ? (grossFare / noOfPassenger).toFixed(2) : grossFare.toFixed(2);

        html += `
        <div class="bg-white rounded-2xl shadow-lg border border-blue-100/50 hover:shadow-2xl transition-all duration-300 overflow-visible relative group">
            <!-- Refundable/Non-Refundable Badge -->
            <div class="relative h-0">
                <div class="absolute -top-2 -right-2 z-10">
                    ${isRefundable ? `
                        <span class="inline-flex items-center gap-1 bg-gradient-to-r from-green-400 to-emerald-400 text-white text-xs px-3 py-1.5 rounded-full border border-green-300 shadow-lg">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                            Refundable
                        </span>
                    ` : `
                        <span class="inline-flex items-center gap-1 bg-gradient-to-r from-red-400 to-rose-400 text-white text-xs px-3 py-1.5 rounded-full border border-red-300 shadow-lg">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                            Non-Refundable
                        </span>
                    `}
                </div>
            </div>

            <!-- Main Content -->
            <div class="p-5">
                <!-- Airline and Route Section -->
                <div class="flex items-center justify-between gap-5 mb-3">
                    <!-- Airline -->
                    <div class="flex items-center gap-3 min-w-30">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br ${airlineColor} flex items-center justify-center shadow-lg border-2 border-white shrink-0 group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <h1 class="font-semibold text-gray-800 truncate max-w-40">${carrier}</h1>
                            <p class="text-xs text-gray-500">
                                ${carrierCode}${flightNumber}
                                ${isMultiSegment ? `<span class="text-blue-500 ml-1 font-medium">+${segments.length - 1} more</span>` : ''}
                            </p>
                        </div>
                    </div>

                    <!-- Flight Route -->
                    <div class="flex items-center justify-center px-4 py-2 flex-1">
                        <!-- Origin -->
                        <div class="text-right min-w-20">
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">From</p>
                            <p class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">${origin}</p>
                            <p class="text-sm font-medium text-gray-700">${depTime}</p>
                            <p class="text-xs text-gray-400">${depDate}</p>
                        </div>

                        <!-- Flight Path -->
                        <div class="flex-1 flex flex-col items-center px-4 max-w-45">
                            <div class="flex items-center gap-2 w-full">
                                <div class="flex-1 h-0.5 bg-gradient-to-r from-blue-300 to-indigo-300 relative">
                                    <div class="absolute -top-1 left-0 w-2 h-2 rounded-full bg-blue-400"></div>
                                    <div class="absolute -top-1 right-0 w-2 h-2 rounded-full bg-indigo-500"></div>
                                </div>
                                <div class="shrink-0">
                                    <svg class="w-5 h-5 text-indigo-500 transform rotate-45 group-hover:rotate-90 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                    </svg>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 mt-1 flex-wrap justify-center">
                                <span class="text-xs font-semibold text-gray-700 whitespace-nowrap">${duration}</span>
                                <span class="text-xs text-gray-300">•</span>
                                <span class="text-xs font-medium text-indigo-600 whitespace-nowrap">
                                    ${stops === 0 ? '✈️ Non Stop' : `${stops} Stop${stops > 1 ? 's' : ''}`}
                                </span>
                            </div>
                        </div>

                        <!-- Destination -->
                        <div class="text-left min-w-20">
                            <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">To</p>
                            <p class="text-2xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">${dest}</p>
                            <p class="text-sm font-medium text-gray-700">${arrTime}</p>
                            <p class="text-xs text-gray-400">${arrDate}</p>
