                    </div>

                    <!-- Price & Book Button -->
                    <div class="flex items-center gap-4 mt-2 min-w-35 shrink-0">
                        <div class="text-right">
                            <p class="text-xs text-gray-500 font-medium">per adult</p>
                            <!-- MAIN PRICE: Net per passenger -->
                            <p class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
                                $${perPassengerNet}
                            </p>
                            <!-- Strikethrough Gross for comparison -->
                            <p class="text-xs text-gray-400 line-through">$${perPassengerGross}</p>
                        </div>
                        <div class="flex flex-col items-end">
                            ${!isBookable ? '<p class="text-xs text-red-500 mt-1 whitespace-nowrap">Currently unavailable</p>' : ''}
                        </div>
                    </div>
                </div>

                <!-- Flight Details Grid -->
                <div class="mt-3 pt-3 border-dashed border-t border-blue-100 grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                    <div class="flex items-center gap-2 text-gray-600 min-w-0">
                        <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
