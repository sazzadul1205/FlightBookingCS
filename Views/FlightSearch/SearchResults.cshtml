                        </svg>
                        <span class="truncate font-medium">${carrier}</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-600">
                        <span class="font-medium shrink-0">Flight:</span>
                        <span class="font-semibold text-gray-800 truncate">${carrierCode}${flightNumber}</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-600">
                        <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="font-medium">${duration}</span>
                    </div>
                    <div class="flex items-center gap-2 text-gray-600 min-w-0">
                        <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                        <span class="truncate font-medium" title="${baggageAllowance}">${truncateText(baggageAllowance, 25)}</span>
                    </div>
                </div>

                <!-- Pricing Section (detailed breakdown) -->
                <div class="mt-3 pt-3 border-t border-gray-100 flex flex-wrap items-center gap-4">
                    ${hasPricing ? `
                        <div class="flex items-center gap-2 bg-gradient-to-r from-green-50 to-emerald-50 px-3 py-1.5 rounded-full">
                            <span class="text-xs font-medium text-gray-600">💎 Net:</span>
                            <span class="text-sm font-bold text-gray-800">$${netFare.toFixed(2)}</span>
                        </div>
                        <div class="flex items-center gap-2 bg-gradient-to-r from-blue-50 to-indigo-50 px-3 py-1.5 rounded-full">
                            <span class="text-xs font-medium text-gray-600">💰 Gross:</span>
                            <span class="text-sm font-bold text-gray-800 line-through">$${grossFare.toFixed(2)}</span>
                            <span class="text-xs font-semibold text-green-600">-$${newDiscount.toFixed(2)}</span>
                        </div>
                        <div class="flex items-center gap-1 bg-yellow-100 px-2 py-0.5 rounded-full">
                            <span class="text-xs font-bold text-yellow-700">✨ ${((newDiscount / grossFare) * 100).toFixed(0)}% off</span>
                        </div>
                        <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">🏷️ Special Pricing</span>
                    ` : `
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                            <span class="font-medium">Total: $${totalFare.toFixed(2)}</span>
                            ${apiDiscount > 0 ? `<span class="text-xs text-green-600 bg-green-50 px-2 py-0.5 rounded-full">💰 Saved $${apiDiscount.toFixed(2)}</span>` : ''}
                            ${fees > 0 ? `<span class="text-xs text-gray-400">+ $${fees.toFixed(2)} fees</span>` : ''}
                        </div>
                    `}
                </div>
            </div>
        </div>
    `;
    });

    html += `</div>`;
    container.innerHTML = html;
}              
                // ============================================================
                // 8. INITIALIZATION
                // ============================================================
                const initAirports = async () => {
                    const [origin, dest] = await Promise.all([
                        fetchAirport(initData.originCode),
                        fetchAirport(initData.destinationCode)
                    ]);

                    if (origin) {
                        state.origin = origin;
                        $('originTitle').textContent = extractCity(origin.display);
                        $('originDisplay').textContent = origin.display;
                        $('originDisplay').title = origin.display;
                    }

                    if (dest) {
                        state.destination = dest;
                        $('destinationTitle').textContent = extractCity(dest.display);
                        $('destinationDisplay').textContent = dest.display;
                        $('destinationDisplay').title = dest.display;
                    }

                    // Hide filter sidebar initially
                    document.getElementById('filterSidebar').classList.add('hidden');

                    if (state.origin && state.destination && state.date) {
                        performSearch();
                    } else {
                        $('loadingState').classList.add('hidden');
                        $('flightResults').innerHTML = `
                                            <div class="bg-blue-50 border border-blue-200 text-blue-700 p-6 rounded-xl text-center">
                                                <p class="text-lg font-medium">🔍 Please fill in all fields and click Search</p>
                                            </div>
                                        `;
                    }
                };

                // Event listeners
                document.getElementById('searchButton').addEventListener('click', performSearch);
                document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAll(); });

                // Start
                document.addEventListener('DOMContentLoaded', initAirports);
            </script>
        }

