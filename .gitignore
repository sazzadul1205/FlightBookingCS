```gitignore
# Build artifacts
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
bin/
obj/
out/

# Dependencies
packages/
node_modules/
.nuget/
.nyc_output/
coverage/

# Logs and temp files
*.log
*.tmp
*.temp
*.cache

# Environment
.env
.env.local
*.env.*

# Editors
.vs/
.vshistory/
.vscode/
.idea/
*.userprefs
*.suo
*.user
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Testing
TestResults/
coverage/
*.coverage
*.log

# Azure
azureadmin/
PublishProfiles/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
```